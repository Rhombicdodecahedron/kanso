# Shared secret you type once in Settings (at least 32 characters). `openssl rand -base64 33`
KANSO_TOKEN=
# Signs session cookies. `openssl rand -base64 33`
KANSO_SESSION_SECRET=
# Sync between devices. A Turso database (libsql://…turso.io + its token), or a local file for
# development (file:.data/sync.db). Leave empty to run without sync.
SYNC_DATABASE_URL=
SYNC_DATABASE_TOKEN=
